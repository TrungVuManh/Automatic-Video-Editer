# Bí mật
.env

# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Frontend (bản build cần phân phối nằm trong src/automeme/studio/static/vendor/)
node_modules/

# Test / lint
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Dữ liệu từng video (nặng) — chỉ giữ cấu trúc thư mục
data/*/*
!data/*/.gitkeep

# Meme, GIF, SFX có thể dính bản quyền (SPEC §56) — người dùng tự thêm
assets/memes/*
!assets/memes/.gitkeep
!assets/memes/library.example.jsonl
assets/gifs/*
!assets/gifs/.gitkeep
assets/sfx/*
!assets/sfx/.gitkeep

# Font tự tải về (giấy phép riêng) — chỉ commit README hướng dẫn
assets/fonts/*
!assets/fonts/README.md

# Model tải về
models/

# Code cũ (stream-auto-editor): dữ liệu job và media
legacy/stream_editor/jobs/*
!legacy/stream_editor/jobs/.gitkeep
legacy/stream_editor/meme_library/**/*.mp4
legacy/stream_editor/meme_library/**/*.mov
legacy/stream_editor/meme_library/**/*.webm
legacy/stream_editor/meme_library/**/*.mp3
legacy/stream_editor/meme_library/**/*.wav
legacy/stream_editor/meme_library/**/*.png
legacy/stream_editor/meme_library/**/*.jpg
legacy/stream_editor/meme_library/**/*.gif

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
