# Sao chép thành .env rồi sửa:   Copy-Item .env.example .env
# KHÔNG commit file .env.
#
# Mỗi biến ở đây ghi đè khóa tương ứng trong configs/default.yaml và profile.
# Để trống hoặc comment = không ghi đè.

# =========================================================
# Application
# =========================================================

LOG_LEVEL=INFO

# =========================================================
# Whisper
# =========================================================

WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=vi

# cuda / cpu / auto
WHISPER_DEVICE=cuda

# float16 / int8_float16 / int8
WHISPER_COMPUTE_TYPE=float16

WHISPER_BEAM_SIZE=5

# =========================================================
# LLM
# =========================================================

# ollama (local, mặc định) / claude
LLM_BACKEND=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Chỉ cần khi LLM_BACKEND=claude
# CLAUDE_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# =========================================================
# Meme Search
# =========================================================

MEME_SEARCH_BASE_URL=http://127.0.0.1:3000
MEME_SEARCH_TOKEN=

MEME_SEARCH_TOP_K=10

# =========================================================
# Editing
# =========================================================
# Để comment để profile (--profile subtle|funny|chaotic) quyết định.
# Bỏ comment một dòng = ghi đè giá trị đó cho MỌI profile.

# MEME_MIN_DURATION=0.8
# MEME_MAX_DURATION=2.5

# MEME_COOLDOWN=7.0

# MEME_SCORE_THRESHOLD=0.65

# MAX_MEMES_PER_MINUTE=5

# =========================================================
# Output
# =========================================================

VIDEO_CODEC=libx264
AUDIO_CODEC=aac
OUTPUT_CRF=18
OUTPUT_PRESET=medium
