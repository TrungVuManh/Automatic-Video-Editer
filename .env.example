# Sao chép thành .env rồi sửa:   Copy-Item .env.example .env
# KHÔNG commit file .env.
#
# Mỗi biến ở đây ghi đè khóa tương ứng trong configs/default.yaml và profile.
# Để trống hoặc comment = không ghi đè.

# =========================================================
# Application
# =========================================================

LOG_LEVEL=INFO

# =========================================================
# Whisper
# =========================================================

WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=vi

# cuda / cpu / auto
WHISPER_DEVICE=cuda

# float16 / int8_float16 / int8
WHISPER_COMPUTE_TYPE=float16

WHISPER_BEAM_SIZE=5

# Bỏ qua đoạn im lặng; tắt ngữ cảnh câu trước để đỡ lặp chữ. Mặc định: true / false
# WHISPER_VAD_FILTER=true
# WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Gợi ý từ vựng cho Whisper (file trong prompts/), ví dụ cho livestream game:
# WHISPER_HOTWORDS_FILE=prompts/whisper_livestream_vi.txt

# =========================================================
# LLM
# =========================================================

# ollama (local, mặc định) / claude
LLM_BACKEND=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Chỉ cần khi LLM_BACKEND=claude
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low
# ANTHROPIC_API_KEY=

# Độ trễ từ cuối câu đến lúc meme xuất hiện (giây). Để comment để dùng mặc định 0.15.
# MEME_TIMING_DELAY=0.15

# =========================================================
# Meme Search
# =========================================================

MEME_SEARCH_BASE_URL=http://127.0.0.1:3000
MEME_SEARCH_TOKEN=

MEME_SEARCH_TOP_K=10
# MEME_SEARCH_MAX_DOWNLOAD_MB=25

# Metadata local; để trống thì dùng assets/memes/library.jsonl
# MEME_LIBRARY_FILE=assets/memes/library.jsonl

# =========================================================
# Editing
# =========================================================
# Để comment để profile (--profile subtle|funny|chaotic) quyết định.
# Bỏ comment một dòng = ghi đè giá trị đó cho MỌI profile.

# MEME_MIN_DURATION=0.8
# MEME_MAX_DURATION=2.5

# MEME_COOLDOWN=7.0

# MEME_SCORE_THRESHOLD=0.65

# MAX_MEMES_PER_MINUTE=5

# =========================================================
# Sound effects
# =========================================================

# SFX_ENABLED=true
# SFX_LIBRARY_FILE=assets/sfx/library.jsonl
# SFX_VOLUME=0.35
# SFX_SCORE_THRESHOLD=0.35
# SFX_COOLDOWN=8.0
# MAX_SFX_PER_MINUTE=3
# SFX_MAX_DURATION=2.0

# =========================================================
# Tải YouTube
# =========================================================

# Kênh của bạn, cách nhau bằng dấu phẩy: @handle, mã kênh UC… hoặc link kênh.
# Video từ các kênh này không hiện cảnh báo bản quyền khi tải.
# YOUTUBE_OWN_CHANNELS=@ten_kenh_cua_ban

# =========================================================
# Output
# =========================================================

VIDEO_CODEC=libx264
AUDIO_CODEC=aac
OUTPUT_CRF=18
OUTPUT_PRESET=medium
